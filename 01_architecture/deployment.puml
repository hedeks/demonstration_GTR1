@startuml Deployment_Architecture
skinparam nodeBackgroundColor white
skinparam componentStyle uml2

title Диаграмма Развертывания и IPC (Deployment & Communication - Native Host)

node "Host System (Ubuntu 22.04 / WSL2)" {
  
  package "C++ Core (High Performance)" {
    [Dataset Player / Sim Stream] --> [SLGW (SLAM)] : RGB-D (30/60 FPS)
    [SLGW (SLAM)] --> [MP10 / MP11 / MP12 / MP13] : In-memory (Shared Pointers)
    [SPL1 (Splicer)] <--> [MP10 / MP11 / MP12 / MP13]
    [PRD1 (Predictor)] <--> [MP10 / MP11 / MP12 / MP13]
    
    portout "ZeroMQ (REQ)" as ZMQ_REQ
    portin "ZeroMQ (PUB)" as ZMQ_PUB
  }
  
  package "Python ML Service" {
    component "CNN1 Worker (YOLOv8)" as CNN1
    portin "ZeroMQ (REP)" as ZMQ_REP
  }

  package "Python Simulation" {
    component "PyBullet Environment" as SimEnv
    portin "ZeroMQ (REP/PUB)" as ZMQ_SIM
  }
  
  ZMQ_REQ <--> ZMQ_REP : "Protobuf Messages (IPC)\n< 100ms Latency"
  ZMQ_REQ <--> ZMQ_SIM : "SensorFrame & CmdVel (ZeroMQ)"
  
  package "WebSocket Bridge (Python)" {
    component "ws_bridge.py" as WSBridge
  }

  ZMQ_PUB --> WSBridge : "ZeroMQ Telemetry (Port 5556)"
  
  node "User Browser" {
    [Web Dashboard (Three.js)]
  }
  
  WSBridge --> [Web Dashboard (Three.js)] : "WebSockets ws://localhost:8081"
}

@enduml
