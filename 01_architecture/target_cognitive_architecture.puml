@startuml Target_Cognitive_Architecture
skinparam componentStyle uml2
skinparam backgroundColor #FEFEFE
skinparam roundcorner 10
skinparam defaultFontName "Segoe UI", Arial, sans-serif

skinparam package {
  BackgroundColor #F4F6F9
  BorderColor #5A6B7C
  FontColor #1C2833
  FontStyle bold
}

skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  FontColor #2C3E50
  ArrowColor #2980B9
}

title GTR1 Neuro-Symbolic Target Architecture (PRD1 Action-Tokens & SPL1 Dynamic Kinematics)

package "1. Perception & World State (DTR Feed-Forward)" {
  [Sensor Stream\n(PyBullet / Real RGB-D / TUM)] as SENS
  [SLGW Sensor Linker\n(Kalman SE3 + Bilateral Depth Filter)] as SLGW
  [MP10 Space\n(OctoMap 3D Occupancy Grid)] as MP10
  [MP11 Manager\n(3D Object Invariants)] as MP11
  [CNN1 + CLIP ML Service\n(YOLOv8 + ViT-B/32 on CUDA)] as ML_CNN

  SENS -right-> SLGW : "RGB + Depth + T_cam\n(Independent Real-Time)"
  SLGW -down-> ML_CNN : "RGB Frame (ZMQ REP 5555)"
  ML_CNN -up-> MP11 : "3D BBoxes + 512-d CLIP Embeddings"
  SLGW -right-> MP10 : "3D Point Cloud Voxelization"
}

package "2. Motivation & Needs" {
  [MTV1 Motivator\n(Need Vector Injection)] as MTV1
  note bottom of MTV1
    Target: Semantic Class ("cup")
    or Geometric 3D Waypoint
    Calculates Distance-to-Zero
  end note
}

package "3. Macro-Level Reasoning: Strategic Mind (ISSUE-10)" {
  [PRD1 Action-Token Predictor\n(Autoregressive Trajectory Policy / Transformer)] as PRD1
  [TRL1 Log\n(Episodic Memory of Past BLOMs)] as TRL1
  [TCH1 Teacher\n(Continuous Outcome Reward Evaluator)] as TCH1

  MTV1 -down-> PRD1 : "Target Need & Coordinates"
  MP11 -down-> PRD1 : "Observed Object Anchors"
  MP10 -down-> PRD1 : "Global Obstacle Context"
  TRL1 <-> PRD1 : "Retrieve Similar Past Routes (Outcome >= 0.85)"
  
  PRD1 -right-> [BLOM Event Chain] : "Predict Next Action Token\n(OPRN Sequence)"
}

package "4. Micro-Level Kinematics: Motor Cerebellum (ISSUE-11)" {
  [BLOM Event Chain] -down-> [SPL1 Dynamic Splicer] : "Active OPRN Token\n(Subject, b-vector, Target)"
  [SPL1 Dynamic Splicer\n(Local Kinematic Policy / Actor-Critic)] as SPL1
  
  MP10 -down-> SPL1 : "Local SDF / Distance Field (1.5m)"
  
  SPL1 -down-> [Kinematic Setpoints] : "Predict: (Δvx, Δwz, progress, curvature)"
  SPL1 -right-> [Elastic Splice Warping] : "Local Arc Bypass\n(No PRD1 Replan Needed)"
}

package "5. Deterministic Safety Shield (Mathematical Barrier)" {
  [Kinematic Setpoints] -down-> [Safety Guard\n(Clearance Envelope & Limits)] as GUARD
  MP10 -down-> GUARD : "OctoMap Collision Raycast"
  
  GUARD -down-> [Chassis Actuators\n(PyBullet / Real Motors)] : "VALIDATED KinematicCommand\n(Safe vx, wz)"
  GUARD -.-> SPL1 : "COLLISION: Feedback Penalty & Retry"
}

package "6. Synchronous Telemetry & Human-in-the-Loop" {
  [Telemetry Publisher\n(Unified TICK_BUNDLE Port 5556)] as TELEM
  [WebSocket Bridge\n(ws_bridge.py Port 8081)] as WS
  [Three.js Dashboard & Inspector\n(WebGL UI Port 8000)] as UI

  SENS -down-> TELEM : "frame_id, timestamp"
  MP10 -down-> TELEM : "Voxels (Throttled 5-ticks)"
  GUARD -down-> TELEM : "Robot Pose, vx, wz (Every tick)"
  [BLOM Event Chain] -down-> TELEM : "OPRN Triplet Graph & Progress"
  MTV1 -down-> TELEM : "Active Goal & Status"

  TELEM -right-> WS : "Atomic JSON Bundle"
  WS -right-> UI : "Synchronous 0ms Jitter Telemetry"
  UI -left-> MTV1 : "Dynamic Target (Click-to-Nav / Voice / Text)"
}

@enduml
